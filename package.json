{
  "name": "aerion-drive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client",
    "lint": "eslint client/src server/src",
    "test": "npm run test -w server",
    "test:mongo": "npm run test:mongo -w server",
    "seed": "npm run seed -w server",
    "start": "npm run start -w server",
    "test:browser": "playwright test",
    "dev:full": "node scripts/dev-full.mjs",
    "test:fullstack": "playwright test --config playwright.fullstack.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.71.1"
  }
}
