# Copy this file to server/.env. Never commit server/.env.
MONGODB_URI=mongodb://127.0.0.1:27017/aerion-drive
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Generate a random secret with at least 32 characters before starting.
SESSION_SECRET=
# Set these only for npm run seed; no default administrator credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
